---
const latestTweet = {
  id: '2123074878677172637',
  url: 'https://x.com/IvanovXapu/status/2123074878677172637',
  author: {
    name: 'Hristiqn',
    handle: '@IvanovXapu',
    avatar: '/avatar-ivanovxapu.jpg',
  },
  text: "Don't forget there is a reason why there is a reminder for not using dev serve on prod",
  quote: {
    name: 'Vite ⚡',
    handle: '@vite_js',
    text: "We've published a critical advisory affecting the dev server.\n\nhttps://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7\n\nPlease make sure to update now to the patched versions (or newer if available)\n- Vite 8.3.7, 8.2.5, 8.1.7, 7.3.8, 6.4.6\n- Vite+ 1.5.1",
  },
  date: '5:24 PM · Nov 18, 2026',
  metrics: {
    replies: 0,
    retweets: 0,
    likes: 0,
    views: 5,
  },
};
---

<section class="my-8" aria-label="Latest Post on X">
  <div class="mb-3 flex items-center justify-between">
    <div class="flex items-center gap-2 font-mono text-xs text-gray-400">
      <svg class="h-3.5 w-3.5 text-gray-200" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
      <span class="font-semibold uppercase tracking-wider text-gray-300">Latest on X</span>
      <span>&bull;</span>
      <a
        href="https://x.com/IvanovXapu"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline"
      >
        {latestTweet.author.handle}
      </a>
      <span
        id="preview-live-badge"
        class="hidden rounded border border-emerald-500/30 bg-emerald-500/10 px-1.5 py-0.5 text-[10px] text-accent"
      >
        Live Synced
      </span>
    </div>

    <div class="flex items-center gap-3 font-mono text-xs">
      <a
        id="preview-studio-link"
        href={`/x-export?url=${encodeURIComponent(latestTweet.url)}`}
        class="inline-flex items-center gap-1.5 text-accent transition-colors hover:text-accent-hover"
      >
        <span>Customize in X Studio</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <div class="rounded-xl border border-border bg-surface p-5 shadow-lg transition-colors hover:border-gray-700 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <a
        href="https://x.com/IvanovXapu"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3"
      >
        <img
          src={latestTweet.author.avatar}
          alt={latestTweet.author.name}
          width="44"
          height="44"
          class="h-11 w-11 rounded-full border border-border object-cover"
        />
        <div>
          <div class="flex items-center gap-1.5">
            <span
              id="preview-author-name"
              class="font-semibold text-gray-100 transition-colors group-hover:text-accent"
            >
              {latestTweet.author.name}
            </span>
            <svg viewBox="0 0 22 22" class="h-4 w-4 fill-[#1d9bf0]" aria-label="Verified">
              <path d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z" />
            </svg>
          </div>
          <span class="block font-mono text-xs text-gray-400">{latestTweet.author.handle}</span>
        </div>
      </a>

      <a
        id="preview-x-icon-link"
        href={latestTweet.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open post on X"
        class="rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-canvas hover:text-gray-100"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
    </div>

    <p
      id="preview-tweet-text"
      class="mt-4 whitespace-pre-line text-sm leading-relaxed text-gray-200 sm:text-base"
    >
      {latestTweet.text}
    </p>

    <!-- Quoted Tweet Block -->
    <div
      id="preview-quote-box"
      class="mt-3.5 rounded-lg border border-border bg-canvas/70 p-3.5 text-xs sm:text-sm"
    >
      <div class="flex items-center gap-1.5 font-mono text-xs">
        <span id="preview-quote-name" class="font-semibold text-gray-200">
          {latestTweet.quote.name}
        </span>
        <span id="preview-quote-handle" class="text-gray-400">
          {latestTweet.quote.handle}
        </span>
      </div>
      <p
        id="preview-quote-text"
        class="mt-1.5 whitespace-pre-line text-xs leading-relaxed text-gray-300 sm:text-sm"
      >
        {latestTweet.quote.text}
      </p>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-3.5 font-mono text-xs text-gray-400">
      <div class="flex items-center gap-5">
        <span class="inline-flex items-center gap-1.5" title="Replies">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span id="preview-replies">{latestTweet.metrics.replies}</span>
        </span>
        <span class="inline-flex items-center gap-1.5" title="Reposts">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <polyline points="17 1 21 5 17 9" />
            <path d="M3 11V9a4 4 0 0 1 4-4h14" />
            <polyline points="7 23 3 19 7 15" />
            <path d="M21 13v2a4 4 0 0 1-4 4H3" />
          </svg>
          <span id="preview-retweets">{latestTweet.metrics.retweets}</span>
        </span>
        <span class="inline-flex items-center gap-1.5" title="Views">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <line x1="18" y1="20" x2="18" y2="10" />
            <line x1="12" y1="20" x2="12" y2="4" />
            <line x1="6" y1="20" x2="6" y2="14" />
          </svg>
          <span id="preview-views">{latestTweet.metrics.views}</span>
        </span>
        <span id="preview-date">{latestTweet.date}</span>
      </div>

      <div class="flex items-center gap-3">
        <a
          id="preview-export-btn"
          href={`/x-export?url=${encodeURIComponent(latestTweet.url)}`}
          class="rounded border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-accent transition-colors hover:bg-accent hover:text-canvas"
        >
          Export as Card
        </a>
        <a
          id="preview-view-link"
          href={latestTweet.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 transition-colors hover:text-gray-100"
        >
          View on X &nearr;
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    (async () => {
      try {
        // Dynamically discover newest status ID from @IvanovXapu timeline
        let targetId = '2123074878677172637';
        try {
          const timelineRes = await fetch('https://r.jina.ai/https://x.com/IvanovXapu', {
            headers: { 'X-Return-Format': 'html' },
          });
          if (timelineRes.ok) {
            const html = await timelineRes.text();
            const matches = [
              ...html.matchAll(/(?:IvanovXapu\/status\/|in_reply_to=)(\d{15,25})/gi),
            ].map((m) => m[1]);
            if (matches.length > 0) {
              targetId = matches.sort((a, b) => (BigInt(b) > BigInt(a) ? 1 : -1))[0];
            }
          }
        } catch (_) {
          // Use fallback latest ID if timeline discovery is blocked
        }

        const fxRes = await fetch(`https://api.fxtwitter.com/IvanovXapu/status/${targetId}`);
        if (!fxRes.ok) return;
        const data = await fxRes.json();
        const t = data?.tweet;
        if (!t) return;

        const tweetUrl = `https://x.com/IvanovXapu/status/${t.id}`;
        document.getElementById('preview-tweet-text').textContent = t.text || '';
        document.getElementById('preview-replies').textContent = String(t.replies ?? 0);
        document.getElementById('preview-retweets').textContent = String(t.retweets ?? 0);
        document.getElementById('preview-views').textContent = String(t.views ?? 0);

        if (t.created_timestamp) {
          const d = new Date(t.created_timestamp * 1000);
          const timeStr = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
          const dateStr = d.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
          document.getElementById('preview-date').textContent = `${timeStr} · ${dateStr}`;
        }

        const quoteBox = document.getElementById('preview-quote-box');
        if (t.quote && t.quote.text) {
          document.getElementById('preview-quote-name').textContent =
            t.quote.author?.name || 'User';
          document.getElementById('preview-quote-handle').textContent =
            `@${(t.quote.author?.screen_name || 'user').replace(/^@/, '')}`;
          document.getElementById('preview-quote-text').textContent = t.quote.text;
          quoteBox.classList.remove('hidden');
        } else {
          quoteBox.classList.add('hidden');
        }

        document.getElementById('preview-studio-link').href =
          `/x-export?url=${encodeURIComponent(tweetUrl)}`;
        document.getElementById('preview-export-btn').href =
          `/x-export?url=${encodeURIComponent(tweetUrl)}`;
        document.getElementById('preview-x-icon-link').href = tweetUrl;
        document.getElementById('preview-view-link').href = tweetUrl;
        document.getElementById('preview-live-badge').classList.remove('hidden');
      } catch (_) {
        // Keep pre-rendered latest tweet
      }
    })();
  </script>
</section>
