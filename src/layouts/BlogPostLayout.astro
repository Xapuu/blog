---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDate, getReadingTime } from '@components/readingTime';
import { extractSocialSummary } from '@components/postVisibility';

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
}

const { post, prevPost = null, nextPost = null } = Astro.props;
const { title, description, pubDate, updatedDate, tags, series, adventDay, draft } = post.data;

const readingTime = getReadingTime(post.body);
const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const adventDayFormatted = adventDay ? String(adventDay).padStart(2, '0') : '01';
const socialSummary = extractSocialSummary(post);
const xStudioUrl = `/x-export?text=${encodeURIComponent(socialSummary)}`;
const prevDayLabel =
  prevPost?.data.series === 'advent-2026' && typeof prevPost.data.adventDay === 'number'
    ? `← Day ${String(prevPost.data.adventDay).padStart(2, '0')}`
    : '← Previous Post';
const nextDayLabel =
  nextPost?.data.series === 'advent-2026' && typeof nextPost.data.adventDay === 'number'
    ? `Day ${String(nextPost.data.adventDay).padStart(2, '0')} →`
    : 'Next Post →';
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  ogImage={`/og/${post.slug}.png`}
>
  <article class="mx-auto max-w-3xl">
    <!-- Top Back Link & Series Badge -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-gray-400 transition-colors hover:text-accent"
      >
        <span aria-hidden="true">&larr;</span> All Posts
      </a>

      <div class="flex flex-wrap items-center gap-2">
        {
          draft && (
            <span class="rounded-full border border-amber-500/40 bg-amber-500/10 px-3 py-1 font-mono text-xs font-semibold text-amber-400">
              DRAFT PREVIEW (DEV)
            </span>
          )
        }
        {
          series === 'advent-2026' && (
            <a
              href="/advent-2026"
              class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1 font-mono text-xs font-medium text-accent transition-colors hover:border-accent hover:bg-emerald-500/20"
            >
              <span>DevSec Advent &bull; Day {adventDayFormatted}/24</span>
            </a>
          )
        }
        <a
          href={xStudioUrl}
          class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-gray-300 transition-colors hover:border-accent hover:text-accent"
          title="Load this article's social summary into X Card Studio"
        >
          <span>{import.meta.env.DEV ? 'Open Summary in X Studio →' : 'Share Card in X Studio →'}</span>
        </a>
      </div>
    </div>

    <!-- Article Header -->
    <header class="border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-gray-400">
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        <span aria-hidden="true">&bull;</span>
        <span>{readingTime}</span>
        {
          formattedUpdatedDate && (
            <>
              <span aria-hidden="true">&bull;</span>
              <span>Updated {formattedUpdatedDate}</span>
            </>
          )
        }
      </div>

      <h1 class="mt-3 text-2xl font-bold tracking-tight text-gray-100 sm:text-4xl sm:leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-base leading-relaxed text-gray-400 sm:text-lg">
        {description}
      </p>

      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.slice(0, 5).map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded border border-border bg-surface px-2.5 py-1 font-mono text-xs text-gray-300 transition-colors hover:border-accent/50 hover:text-accent"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <!-- Markdown Content -->
    <div
      class="prose prose-invert prose-emerald mt-10 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-gray-100 prose-p:leading-relaxed prose-p:text-gray-300 prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-100 prose-li:text-gray-300"
    >
      <slot />
    </div>

    <!-- Previous / Next Navigation -->
    {
      (prevPost || nextPost) && (
        <nav
          aria-label="Post navigation"
          class="mt-14 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
        >
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="group flex flex-col justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-gray-700 hover:bg-surface-hover"
            >
              <span class="font-mono text-xs text-gray-400">{prevDayLabel}</span>
              <span class="mt-1.5 font-medium text-gray-200 transition-colors group-hover:text-accent">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}`}
              class="group flex flex-col justify-between rounded-lg border border-border bg-surface p-4 text-left transition-colors hover:border-gray-700 hover:bg-surface-hover sm:text-right"
            >
              <span class="font-mono text-xs text-gray-400">{nextDayLabel}</span>
              <span class="mt-1.5 font-medium text-gray-200 transition-colors group-hover:text-accent">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <script is:inline>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-code-btn';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy'), 1800);
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>
