    function parseTweetUrl(input) {
      const trimmed = (input || '').trim();
      const urlMatch = trimmed.match(/(?:x\.com|twitter\.com)\/([a-zA-Z0-9_]+)\/status\/(\d+)/i);
      if (urlMatch) return { screenName: urlMatch[1], id: urlMatch[2] };
      const idMatch = trimmed.match(/(\d{1,25})/);
      if (idMatch) return { screenName: 'i', id: idMatch[1] };
      return null;
    }

    function formatCompactNumber(num) {
      if (num === null || num === undefined) return '0';
      const n = Number(num);
      if (isNaN(n)) return String(num);
      if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
      return String(n);
    }

    function formatDateString(timestampOrStr) {
      const d = new Date(timestampOrStr);
      if (isNaN(d.getTime())) return '10:38 AM · Nov 16, 2026';
      const timeStr = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      const dateStr = d.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });
      return `${timeStr} · ${dateStr}`;
    }

    function escapeHtml(str) {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function formatTweetBodyHtml(rawText) {
      const escaped = escapeHtml(rawText);
      return escaped.replace(
        /(@[a-zA-Z0-9_]+|#[a-zA-Z0-9_]+|https?:\/\/[^\s]+)/g,
        '<span class="highlight">$1</span>'
      );
    }

    function getInitials(name) {
      const clean = (name || 'X').trim();
      const parts = clean.split(/\s+/);
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return clean.slice(0, 2).toUpperCase();
    }

    function showBanner(msg) {
      statusMessage.textContent = msg;
      statusBanner.classList.remove('hidden');
    }

    function hideBanner() {
      statusBanner.classList.add('hidden');
    }

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(showToast._timer);
      showToast._timer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2600);
    }

    async function loadTweet(url) {
      const parsed = parseTweetUrl(url);
      if (!parsed) {
        showBanner('Please enter a valid X / Twitter post URL or status ID.');
        return;
      }

      fetchBtn.disabled = true;
      fetchBtn.querySelector('span').textContent = 'Loading...';
      hideBanner();

      try {
        const res = await fetch(`https://api.fxtwitter.com/${parsed.screenName}/status/${parsed.id}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (!data || !data.tweet) throw new Error('No tweet payload');
        const t = data.tweet;

        const isIvanov =
          (t.author?.screen_name || '').toLowerCase() === 'ivanovxapu' ||
          parsed.id === '2122247887505576345';

        const normalized = {
          id: t.id || parsed.id,
          text: t.text || '',
          created_timestamp: t.created_timestamp ? t.created_timestamp * 1000 : t.created_at,
          author: {
            name: t.author?.name || parsed.screenName,
            screen_name: t.author?.screen_name || parsed.screenName,
            avatar_url: isIvanov
              ? '/avatar-ivanovxapu.jpg'
              : (t.author?.avatar_url || '')
                  .replace('_normal.', '_400x400.')
                  .replace('_200x200.', '_400x400.'),
            verified: Boolean(t.author?.verification?.verified ?? true),
          },
          metrics: {
            replies: t.replies ?? 0,
            retweets: t.retweets ?? 0,
            likes: t.likes ?? 0,
            views: t.views ?? 0,
          },
          photos: t.media?.photos || [],
          videos: t.media?.videos || [],
          quote: t.quote
            ? {
                author: {
                  name: t.quote.author?.name || 'User',
                  screen_name: t.quote.author?.screen_name || 'user',
                },
                text: t.quote.text || '',
              }
            : null,
        };

        renderTweetToCard(normalized);
      } catch (err) {
        if (SEEDED_TWEETS[parsed.id]) {
          renderTweetToCard(SEEDED_TWEETS[parsed.id]);
        } else {
          showBanner('Could not reach live post API; click any field on the card to edit directly.');
        }
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.querySelector('span').textContent = 'Load Post';
      }
    }

    function renderTweetToCard(tweet) {
      currentTweetId = tweet.id || 'post';
      const authorName = tweet.author?.name || 'User';
      const screenName = tweet.author?.screen_name || 'user';

      cardName.textContent = authorName;
      cardHandle.textContent = `@${screenName.replace(/^@/, '')}`;
      cardWatermark.textContent = `x.com/${screenName.replace(/^@/, '')}`;

      avatarFallback.textContent = getInitials(authorName);
      if (tweet.author?.avatar_url) {
        cardAvatar.src = tweet.author.avatar_url;
        cardAvatar.classList.remove('hidden');
        avatarFallback.classList.add('hidden');
        cardAvatar.onerror = () => {
          cardAvatar.classList.add('hidden');
          avatarFallback.classList.remove('hidden');
        };
      } else {
        cardAvatar.classList.add('hidden');
        avatarFallback.classList.remove('hidden');
      }

      toggleVerified.checked = Boolean(tweet.author?.verified ?? true);
      cardVerified.classList.toggle('hidden', !toggleVerified.checked);

      cardText.innerHTML = formatTweetBodyHtml(tweet.text || '');

      if (tweet.quote && tweet.quote.text) {
        quoteName.textContent = tweet.quote.author?.name || 'User';
        quoteHandle.textContent = `@${(tweet.quote.author?.screen_name || 'user').replace(/^@/, '')}`;
        quoteText.textContent = tweet.quote.text;
        cardQuote.classList.remove('hidden');
      } else {
        cardQuote.classList.add('hidden');
      }

      const firstPhoto = tweet.photos && tweet.photos[0] ? tweet.photos[0].url : null;
      const firstVideoThumb =
        tweet.videos && tweet.videos[0] ? tweet.videos[0].thumbnail_url : null;
      const mediaUrl = firstPhoto || firstVideoThumb;

      if (mediaUrl) {
        hasMediaAttachment = true;
        cardMediaImg.src = mediaUrl;
        cardMediaContainer.classList.toggle('hidden', !toggleMedia.checked);
      } else {
        hasMediaAttachment = false;
        cardMediaImg.src = '';
        cardMediaContainer.classList.add('hidden');
      }

      cardDate.textContent = formatDateString(tweet.created_timestamp || tweet.created_at);
      metricReplies.textContent = formatCompactNumber(tweet.metrics?.replies ?? 0);
      metricRetweets.textContent = formatCompactNumber(tweet.metrics?.retweets ?? 0);
      metricLikes.textContent = formatCompactNumber(tweet.metrics?.likes ?? 0);
      metricViews.textContent = formatCompactNumber(tweet.metrics?.views ?? 0);
    }

    urlForm.addEventListener('submit', (e) => {
      e.preventDefault();
      loadTweet(urlInput.value.trim());
    });

    clearBtn.addEventListener('click', () => {
      urlInput.value = '';
      urlInput.focus();
    });

    closeBannerBtn.addEventListener('click', hideBanner);

    async function discoverAndLoadLatestIvanovTweet() {
      const syncBtn = document.getElementById('sync-latest-btn');
      if (syncBtn) syncBtn.textContent = 'Syncing...';
      try {
        const res = await fetch('https://r.jina.ai/https://x.com/IvanovXapu', {
          headers: { 'X-Return-Format': 'html' },
        });
        if (res.ok) {
          const html = await res.text();
          const matches = [
            ...html.matchAll(/(?:IvanovXapu\/status\/|in_reply_to=)(\d{15,25})/gi),
          ].map((m) => m[1]);
          if (matches.length > 0) {
            const newestId = matches.sort((a, b) => (BigInt(b) > BigInt(a) ? 1 : -1))[0];
            const newestUrl = `https://x.com/IvanovXapu/status/${newestId}`;
            urlInput.value = newestUrl;
            await loadTweet(newestUrl);
            return;
          }
        }
      } catch (_) {
        // Fallback to current input URL
      } finally {
        if (syncBtn) syncBtn.textContent = '↻ Sync Latest';
      }
      await loadTweet(urlInput.value.trim());
    }

    document.getElementById('sync-latest-btn')?.addEventListener('click', () => {
      discoverAndLoadLatestIvanovTweet();
    });

    document.querySelectorAll('.pill-btn[data-url]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const u = btn.getAttribute('data-url');
        urlInput.value = u;
        loadTweet(u);
      });
    });

    bgSwatches.addEventListener('click', (e) => {
      const swatch = e.target.closest('.swatch');
      if (!swatch) return;
      bgSwatches.querySelectorAll('.swatch').forEach((s) => s.classList.remove('active'));
      swatch.classList.add('active');
      exportCanvas.style.background = swatch.getAttribute('data-bg');
    });

    themeControl.addEventListener('click', (e) => {
      const btn = e.target.closest('.seg-btn');
      if (!btn) return;
      themeControl.querySelectorAll('.seg-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      tweetCard.className = `tweet-card theme-${btn.getAttribute('data-theme')}`;
    });

    ratioControl.addEventListener('click', (e) => {
      const btn = e.target.closest('.seg-btn');
      if (!btn) return;
      ratioControl.querySelectorAll('.seg-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      exportCanvas.className = `export-canvas ratio-${btn.getAttribute('data-ratio')}`;
    });

    paddingSlider.addEventListener('input', () => {
      const v = `${paddingSlider.value}px`;
      paddingVal.textContent = v;
      document.documentElement.style.setProperty('--card-padding', v);
    });

    widthSlider.addEventListener('input', () => {
      const v = `${widthSlider.value}px`;
      widthVal.textContent = v;
      document.documentElement.style.setProperty('--card-width', v);
    });

    fontSlider.addEventListener('input', () => {
      const v = `${fontSlider.value}px`;
      fontVal.textContent = v;
      document.documentElement.style.setProperty('--card-font-size', v);
    });

    toggleVerified.addEventListener('change', () => {
      cardVerified.classList.toggle('hidden', !toggleVerified.checked);
    });

    toggleLogo.addEventListener('change', () => {
      cardLogo.classList.toggle('hidden', !toggleLogo.checked);
    });

    toggleMedia.addEventListener('change', () => {
      if (hasMediaAttachment) {
        cardMediaContainer.classList.toggle('hidden', !toggleMedia.checked);
      }
    });

    toggleDate.addEventListener('change', () => {
      cardDate.classList.toggle('hidden', !toggleDate.checked);
    });

    toggleMetrics.addEventListener('change', () => {
      cardMetrics.classList.toggle('hidden', !toggleMetrics.checked);
    });

    toggleWatermark.addEventListener('change', () => {
      cardWatermark.classList.toggle('hidden', !toggleWatermark.checked);
    });

    avatarWrap.addEventListener('click', () => uploadAvatar.click());

    uploadAvatar.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        cardAvatar.src = reader.result;
        cardAvatar.classList.remove('hidden');
        avatarFallback.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    });

    uploadMedia.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        hasMediaAttachment = true;
        toggleMedia.checked = true;
        cardMediaImg.src = reader.result;
        cardMediaContainer.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });

    async function inlineAllImages(rootEl) {
      const imgs = Array.from(rootEl.querySelectorAll('img'));
      await Promise.all(
        imgs.map(async (img) => {
          if (!img.src || img.src.startsWith('data:') || img.classList.contains('hidden')) return;
          try {
            const res = await fetch(img.src, { mode: 'cors' });
            const blob = await res.blob();
            const dataUrl = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onloadend = () => resolve(reader.result);
              reader.readAsDataURL(blob);
            });
            img.src = dataUrl;
          } catch (e) {
            // Keep existing src if inlining fails
          }
        })
      );
    }

    async function renderNodeToCanvas(node, scale = 2.5) {
      await inlineAllImages(node);
      const rect = node.getBoundingClientRect();
      const width = Math.round(rect.width);
      const height = Math.round(rect.height);

      const clone = node.cloneNode(true);
      function copyComputedStyles(src, dest) {
        const computed = window.getComputedStyle(src);
        let cssText = '';
        for (let i = 0; i < computed.length; i++) {
          const prop = computed[i];
          cssText += `${prop}:${computed.getPropertyValue(prop)};`;
        }
        dest.style.cssText = cssText;
        for (let i = 0; i < src.children.length; i++) {
          if (dest.children[i]) copyComputedStyles(src.children[i], dest.children[i]);
        }
      }
      copyComputedStyles(node, clone);
      clone.style.margin = '0';

      const xml = new XMLSerializer().serializeToString(clone);
      const svgStr = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}"><foreignObject width="100%" height="100%">${xml}</foreignObject></svg>`;
      const svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgStr);

      const img = new Image();
      img.crossOrigin = 'anonymous';
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = reject;
        img.src = svgUrl;
      });

      const canvas = document.createElement('canvas');
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);
      ctx.drawImage(img, 0, 0);
      return canvas;
    }

    downloadBtn.addEventListener('click', async () => {
      const origText = downloadBtn.querySelector('span').textContent;
      downloadBtn.querySelector('span').textContent = 'Exporting...';
      downloadBtn.disabled = true;
      try {
        const canvas = await renderNodeToCanvas(exportCanvas, 2.5);
        const dataUrl = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        const cleanHandle = (cardHandle.textContent || 'x').replace(/[^a-zA-Z0-9_-]/g, '');
        link.download = `x-card-${cleanHandle}-${currentTweetId}.png`;
        link.href = dataUrl;
        link.click();
        showToast('Card downloaded as high-res PNG!');
      } catch (err) {
        showBanner(`Failed to export image: ${err.message}`);
      } finally {
        downloadBtn.querySelector('span').textContent = origText;
        downloadBtn.disabled = false;
      }
    });

    copyImgBtn.addEventListener('click', async () => {
      const origText = copyImgBtn.querySelector('span').textContent;
      copyImgBtn.querySelector('span').textContent = 'Copying...';
      copyImgBtn.disabled = true;
      try {
        const canvas = await renderNodeToCanvas(exportCanvas, 2.5);
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (!blob) throw new Error('Could not generate image blob');
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
        showToast('Card image copied to clipboard!');
      } catch (err) {
        showBanner(`Clipboard copy failed: ${err.message}`);
      } finally {
        copyImgBtn.querySelector('span').textContent = origText;
        copyImgBtn.disabled = false;
      }
    });

    // Check query param ?text=... or ?url=... or auto-discover newest @IvanovXapu tweet
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const paramText = params.get('text');
      const paramUrl = params.get('url');

      if (paramText) {
        renderTweetToCard({
          id: 'advent-summary',
          text: paramText,
          created_timestamp: Date.now(),
          author: {
            name: 'Hristiqn',
            screen_name: 'IvanovXapu',
            avatar_url: '/avatar-ivanovxapu.jpg',
            verified: true,
          },
          metrics: { replies: 12, retweets: 48, likes: 215, views: 4800 },
          photos: [],
          videos: [],
          quote: null,
        });
        showBanner('Loaded blog post social summary into X Card Studio — click any text to tweak before exporting!');
      } else if (paramUrl) {
        urlInput.value = paramUrl;
        loadTweet(paramUrl);
      } else {
        discoverAndLoadLatestIvanovTweet();
      }
    });
  </script>
</BaseLayout>
