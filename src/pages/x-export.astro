---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="X Card Studio — Export X Posts as Shareable Images"
  description="Turn any X (Twitter) post into a crisp, customizable social card and export as a high-resolution PNG."
>
  <div class="x-studio-wrapper">
    <!-- Studio Header / URL Bar -->
    <div class="studio-topbar">
      <div class="studio-brand">
        <div class="studio-logo">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </div>
        <div>
          <h1 class="text-base font-bold tracking-tight text-gray-100">X Card Studio</h1>
          <span class="block font-mono text-xs text-gray-400">
            Turn any X post into a crisp shareable card
          </span>
        </div>
      </div>

      <form id="url-form" class="url-bar">
        <div class="input-wrapper">
          <svg
            class="link-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <input
            type="text"
            id="tweet-url-input"
            placeholder="Paste X / Twitter link (e.g. https://x.com/IvanovXapu/status/2123074878677172637)"
            value="https://x.com/IvanovXapu/status/2123074878677172637"
            required
          />
          <button type="button" id="clear-btn" class="icon-btn" title="Clear URL">✕</button>
        </div>
        <button type="submit" id="fetch-btn" class="primary-btn">
          <span>Load Post</span>
        </button>
      </form>

      <div class="export-actions">
        <button
          type="button"
          id="copy-img-btn"
          class="secondary-btn"
          title="Copy PNG image to clipboard"
        >
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span>Copy Image</span>
        </button>
        <button type="button" id="download-btn" class="accent-btn">
          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Download PNG</span>
        </button>
      </div>
    </div>

    <!-- Status Banner -->
    <div id="status-banner" class="status-banner hidden">
      <span id="status-message"></span>
      <button type="button" id="close-banner-btn" class="banner-close">✕</button>
    </div>

    <!-- Main Studio Workspace -->
    <div class="workspace">
      <!-- Left Sidebar Controls -->
      <aside class="sidebar">
        <!-- Sample Presets -->
        <section class="control-group">
          <label class="group-title">Recent @IvanovXapu Posts</label>
          <div class="preset-pills">
            <button
              type="button"
              id="sync-latest-btn"
              class="pill-btn"
              style="border-color: rgba(16, 185, 129, 0.45); color: #10b981;"
            >
              ↻ Sync Latest
            </button>
            <button
              type="button"
              class="pill-btn"
              data-url="https://x.com/IvanovXapu/status/2123074878677172637"
            >
              #1 Vite Dev Server RCE
            </button>
            <button
              type="button"
              class="pill-btn"
              data-url="https://x.com/IvanovXapu/status/2122957764926357642"
            >
              #2 3rd-Party JS (178 Sites)
            </button>
            <button
              type="button"
              class="pill-btn"
              data-url="https://x.com/IvanovXapu/status/2122601097114296603"
            >
              #3 Oracle &amp; Postgres CVEs
            </button>
            <button
              type="button"
              class="pill-btn"
              data-url="https://x.com/IvanovXapu/status/2122247887505576345"
            >
              #4 GitHub PATs / Cursor
            </button>
          </div>
        </section>

        <!-- Background Gradient -->
        <section class="control-group">
          <label class="group-title">Background Canvas</label>
          <div class="bg-swatches" id="bg-swatches">
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
              style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
              title="Royal Dusk"
            />
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%)"
              style="background: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);"
              title="Sunset Glow"
            />
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #0ea5e9 0%, #2563eb 50%, #7c3aed 100%)"
              style="background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 50%, #7c3aed 100%);"
              title="Oceanic Electric"
            />
            <button
              type="button"
              class="swatch active"
              data-bg="linear-gradient(135deg, #10b981 0%, #047857 50%, #064e3b 100%)"
              style="background: linear-gradient(135deg, #10b981 0%, #047857 50%, #064e3b 100%);"
              title="Emerald Forest"
            />
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #f43f5e 0%, #a855f7 50%, #6366f1 100%)"
              style="background: linear-gradient(135deg, #f43f5e 0%, #a855f7 50%, #6366f1 100%);"
              title="Neon Berry"
            />
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%)"
              style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);"
              title="Midnight Slate"
            />
            <button
              type="button"
              class="swatch"
              data-bg="linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%)"
              style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);"
              title="Minimalist Alabaster"
            />
            <button
              type="button"
              class="swatch"
              data-bg="transparent"
              style="background: repeating-conic-gradient(#334155 0% 25%, #1e293b 0% 50%) 50% / 12px 12px;"
              title="Transparent PNG"
            />
          </div>
        </section>

        <!-- Card Theme -->
        <section class="control-group">
          <label class="group-title">Card Theme</label>
          <div class="segmented-control" id="theme-control">
            <button type="button" class="seg-btn" data-theme="light">Light</button>
            <button type="button" class="seg-btn active" data-theme="dim">Dim</button>
            <button type="button" class="seg-btn" data-theme="dark">Lights Out</button>
            <button type="button" class="seg-btn" data-theme="glass">Glass</button>
          </div>
        </section>

        <!-- Target Aspect Ratio -->
        <section class="control-group">
          <label class="group-title">Social Format / Ratio</label>
          <div class="segmented-control grid-2" id="ratio-control">
            <button type="button" class="seg-btn active" data-ratio="auto">Auto Fit</button>
            <button type="button" class="seg-btn" data-ratio="square">1:1 Square</button>
            <button type="button" class="seg-btn" data-ratio="portrait">4:5 IG Post</button>
            <button type="button" class="seg-btn" data-ratio="story">9:16 Story</button>
            <button type="button" class="seg-btn" data-ratio="wide">16:9 Social</button>
          </div>
        </section>

        <!-- Layout & Spacing -->
        <section class="control-group">
          <div class="slider-header">
            <label class="group-title">Outer Padding</label>
            <span id="padding-val" class="slider-val">48px</span>
          </div>
          <input type="range" id="padding-slider" min="0" max="120" value="48" step="4" />

          <div class="slider-header" style="margin-top: 10px;">
            <label class="group-title">Card Width</label>
            <span id="width-val" class="slider-val">540px</span>
          </div>
          <input type="range" id="width-slider" min="380" max="760" value="540" step="10" />

          <div class="slider-header" style="margin-top: 10px;">
            <label class="group-title">Text Size</label>
            <span id="font-val" class="slider-val">19px</span>
          </div>
          <input type="range" id="font-slider" min="15" max="28" value="19" step="1" />
        </section>

        <!-- Visibility Toggles -->
        <section class="control-group">
          <label class="group-title">Card Elements</label>
          <div class="toggle-list">
            <label class="toggle-row">
              <span>Verified Badge</span>
              <input type="checkbox" id="toggle-verified" checked />
            </label>
            <label class="toggle-row">
              <span>X Brand Logo</span>
              <input type="checkbox" id="toggle-logo" checked />
            </label>
            <label class="toggle-row">
              <span>Post Media / Image</span>
              <input type="checkbox" id="toggle-media" checked />
            </label>
            <label class="toggle-row">
              <span>Timestamp Footer</span>
              <input type="checkbox" id="toggle-date" checked />
            </label>
            <label class="toggle-row">
              <span>Engagement Metrics</span>
              <input type="checkbox" id="toggle-metrics" checked />
            </label>
            <label class="toggle-row">
              <span>Watermark / Handle Bar</span>
              <input type="checkbox" id="toggle-watermark" />
            </label>
          </div>
        </section>

        <!-- Custom Image Attachment -->
        <section class="control-group">
          <label class="group-title">Custom Media / Avatar</label>
          <div class="upload-btns">
            <label class="upload-btn">
              <input type="file" id="upload-avatar" accept="image/*" hidden />
              <span>Upload Avatar</span>
            </label>
            <label class="upload-btn">
              <input type="file" id="upload-media" accept="image/*" hidden />
              <span>Attach Photo</span>
            </label>
          </div>
          <p class="hint-text">
            Tip: Click directly on any text, name, or metric inside the card to edit it live before
            exporting.
          </p>
        </section>
      </aside>

      <!-- Center Preview Stage -->
      <section class="stage-container">
        <div class="stage-scroll">
          <!-- Export Target Wrapper -->
          <div
            id="export-canvas"
            class="export-canvas ratio-auto"
            style="background: linear-gradient(135deg, #10b981 0%, #047857 50%, #064e3b 100%);"
          >
            <div id="tweet-card" class="tweet-card theme-dim">
              <!-- Card Header -->
              <div class="card-header">
                <div class="author-info">
                  <div class="avatar-wrap" id="avatar-wrap" title="Click to upload custom avatar">
                    <img
                      id="card-avatar"
                      class="card-avatar"
                      src="/avatar-ivanovxapu.jpg"
                      alt="Avatar"
                      crossorigin="anonymous"
                    />
                    <div id="avatar-fallback" class="avatar-fallback hidden">HI</div>
                  </div>
                  <div class="author-meta">
                    <div class="author-name-row">
                      <span
                        id="card-name"
                        class="author-name"
                        contenteditable="true"
                        spellcheck="false">Hristiqn</span
                      >
                      <span id="card-verified" class="verified-badge" title="Verified">
                        <svg viewBox="0 0 22 22" width="18" height="18" fill="#1d9bf0">
                          <path d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z" />
                        </svg>
                      </span>
                    </div>
                    <div
                      id="card-handle"
                      class="author-handle"
                      contenteditable="true"
                      spellcheck="false"
                    >
                      @IvanovXapu
                    </div>
                  </div>
                </div>
                <div id="card-logo" class="x-logo">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                </div>
              </div>

              <!-- Card Body Text (Pre-populated with latest tweet from @IvanovXapu) -->
              <div id="card-text" class="card-text" contenteditable="true" spellcheck="false">Don't forget there is a reason why there is a reminder for not using dev serve on prod</div>

              <!-- Quoted Tweet (optional) -->
              <div id="card-quote" class="card-quote">
                <div class="quote-header">
                  <span id="quote-name" class="quote-name" contenteditable="true">Vite ⚡</span>
                  <span id="quote-handle" class="quote-handle" contenteditable="true">@vite_js</span>
                </div>
                <div id="quote-text" class="quote-text" contenteditable="true">We've published a critical advisory affecting the dev server.

https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7

Please make sure to update now to the patched versions (or newer if available)
- Vite 8.3.7, 8.2.5, 8.1.7, 7.3.8, 6.4.6
- Vite+ 1.5.1</div>
              </div>

              <!-- Media Grid (optional) -->
              <div id="card-media-container" class="card-media hidden">
                <img id="card-media-img" src="" alt="Post attachment" crossorigin="anonymous" />
              </div>

              <!-- Timestamp -->
              <div id="card-date" class="card-date" contenteditable="true" spellcheck="false">
                5:24 PM · Nov 18, 2026
              </div>

              <!-- Metrics Footer -->
              <div id="card-metrics" class="card-metrics">
                <div class="metric-item">
                  <svg
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                  </svg>
                  <span id="metric-replies" contenteditable="true">0</span>
                </div>
                <div class="metric-item">
                  <svg
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <polyline points="17 1 21 5 17 9" />
                    <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                    <polyline points="7 23 3 19 7 15" />
                    <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                  </svg>
                  <span id="metric-retweets" contenteditable="true">0</span>
                </div>
                <div class="metric-item metric-likes">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                    <path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91z" />
                  </svg>
                  <span id="metric-likes" contenteditable="true">0</span>
                </div>
                <div class="metric-item">
                  <svg
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                  </svg>
                  <span id="metric-views" contenteditable="true">5</span>
                </div>
              </div>
            </div>

            <!-- Optional Watermark Pill -->
            <div
              id="card-watermark"
              class="card-watermark hidden"
              contenteditable="true"
              spellcheck="false"
            >
              x.com/IvanovXapu
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast hidden">Copied to clipboard!</div>

  <style>
    :root {
      --card-width: 540px;
      --card-padding: 48px;
      --card-font-size: 19px;
    }

    .x-studio-wrapper {
      border: 1px solid #1f2937;
      border-radius: 14px;
      overflow: hidden;
      background: #090d16;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    }

    .studio-topbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 18px;
      background: #111827;
      border-bottom: 1px solid #1f2937;
    }

    .studio-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .studio-logo {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #10b981;
    }

    .url-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      min-width: 260px;
    }

    .input-wrapper {
      position: relative;
      flex: 1;
      display: flex;
      align-items: center;
    }

    .link-icon {
      position: absolute;
      left: 12px;
      color: #94a3b8;
      pointer-events: none;
    }

    #tweet-url-input {
      width: 100%;
      padding: 8px 32px 8px 36px;
      border-radius: 8px;
      border: 1px solid #334155;
      background: #0b0f17;
      color: #f8fafc;
      font-size: 13px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      outline: none;
      transition: border-color 0.15s;
    }

    #tweet-url-input:focus {
      border-color: #10b981;
    }

    .icon-btn {
      position: absolute;
      right: 8px;
      background: none;
      border: none;
      color: #94a3b8;
      cursor: pointer;
      font-size: 12px;
      padding: 4px;
    }

    .icon-btn:hover {
      color: #f8fafc;
    }

    .primary-btn,
    .secondary-btn,
    .accent-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 13px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .primary-btn {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #334155;
    }

    .primary-btn:hover {
      border-color: #10b981;
      color: #10b981;
    }

    .secondary-btn {
      background: #1e293b;
      color: #e2e8f0;
      border: 1px solid #334155;
    }

    .secondary-btn:hover {
      background: #334155;
    }

    .accent-btn {
      background: #10b981;
      color: #0b0f17;
    }

    .accent-btn:hover {
      background: #34d399;
    }

    .export-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .status-banner {
      background: rgba(16, 185, 129, 0.12);
      border-bottom: 1px solid rgba(16, 185, 129, 0.3);
      color: #a7f3d0;
      font-size: 12px;
      padding: 8px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .banner-close {
      background: none;
      border: none;
      color: #6ee7b7;
      cursor: pointer;
      font-size: 13px;
    }

    .workspace {
      display: flex;
      flex-direction: column;
      min-height: 680px;
    }

    @media (min-width: 900px) {
      .workspace {
        flex-direction: row;
      }
    }

    .sidebar {
      width: 100%;
      background: #111827;
      border-bottom: 1px solid #1f2937;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      flex-shrink: 0;
    }

    @media (min-width: 900px) {
      .sidebar {
        width: 290px;
        border-bottom: none;
        border-right: 1px solid #1f2937;
      }
    }

    .control-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .group-title {
      font-size: 11px;
      font-weight: 700;
