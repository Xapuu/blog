---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested resource could not be found."
>
  <section class="mx-auto max-w-xl py-16 text-center">
    <p class="font-mono text-sm font-semibold text-accent">HTTP 404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-100">Page Not Found</h1>
    <p class="mt-3 text-sm leading-relaxed text-gray-400">
      The route you requested does not exist or has been moved.
    </p>
    <div class="mt-6 flex justify-center gap-3 font-mono text-xs">
      <a
        href="/"
        class="rounded-md bg-accent px-4 py-2 font-semibold text-canvas transition-colors hover:bg-accent-hover"
      >
        Return Home
      </a>
      <a
        href="/blog"
        class="rounded-md border border-border bg-surface px-4 py-2 text-gray-200 transition-colors hover:border-accent/50 hover:text-accent"
      >
        Browse Archive
      </a>
    </div>
  </section>
</BaseLayout>
